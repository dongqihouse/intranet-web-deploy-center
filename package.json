{
  "name": "intranet-web-deploy-center",
  "version": "0.1.0",
  "private": true,
  "description": "Single-container intranet web deployment center for Node/Vite/React/Next projects.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node --check server.js && node --check public/app.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "express": "^4.19.2",
    "multer": "^2.1.1"
  }
}
